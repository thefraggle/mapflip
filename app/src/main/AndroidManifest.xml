<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- Package visibility query for web browsers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Supported Navigation Apps -->
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="app.organicmaps" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
        <package android:name="com.here.app.maps" />
        <package android:name="ru.yandex.yandexmaps" />
    </queries>

    <application
        android:name=".MapFlipApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MapFlip">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MapFlip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RedirectActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <!-- 0. Android Share Sheet Receiver (ACTION_SEND) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 1. Apple Maps Links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.apple.com" />
                <data android:scheme="http" android:host="maps.apple.com" />
            </intent-filter>

            <!-- 2. Bing Maps Links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bing.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="www.bing.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="maps.bing.com" />
            </intent-filter>

            <!-- 3. OpenStreetMap Links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="openstreetmap.org" />
                <data android:scheme="https" android:host="www.openstreetmap.org" />
                <data android:scheme="https" android:host="osm.org" />
            </intent-filter>

            <!-- 4. Yandex Maps Links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yandex.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="www.yandex.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="yandex.ru" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="www.yandex.ru" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="maps.yandex.com" />
                <data android:scheme="https" android:host="maps.yandex.ru" />
            </intent-filter>

            <!-- 5. HERE WeGo Links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wego.here.com" />
                <data android:scheme="https" android:host="share.here.com" />
                <data android:scheme="https" android:host="maps.here.com" />
                <data android:scheme="https" android:host="here.com" />
                <data android:scheme="https" android:host="www.here.com" />
            </intent-filter>

            <!-- 6. Waze Web Links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="waze.com" android:pathPrefix="/ul" />
                <data android:scheme="https" android:host="www.waze.com" android:pathPrefix="/ul" />
                <data android:scheme="https" android:host="waze.com" android:pathPrefix="/live-map" />
                <data android:scheme="https" android:host="www.waze.com" android:pathPrefix="/live-map" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tile Service -->
        <service
            android:name=".service.MapFlipTileService"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
